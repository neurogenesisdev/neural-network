    "template": "_templates/monthly-note.md",
    "folder": "journal/monthly",
    "enabled": true
  },
  "quarterly": {
    "format": "YYYY-[Q]Q",
    "template": "_templates/quarterly-note.md",
    "folder": "journal/quarterly",
    "enabled": true
  },
  "yearly": {
    "format": "YYYY",
    "template": "_templates/yearly-note.md",
    "folder": "journal/yearly",
    "enabled": true
